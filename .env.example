# Copy to .env.local and fill in. Nothing here is required: every value has a
# default that works on this machine.

# --- model ------------------------------------------------------------------
# The local model that writes new ideas. Must be pulled already:
#   ollama pull qwen3:8b
MURMUR_MODEL=qwen3:8b

# Where Ollama listens. Keep it on loopback; never expose it.
OLLAMA_HOST=http://127.0.0.1:11434

# How long to wait for the model before the curated corpus answers instead.
# Measured on this box: cold ~24s, warm ~11-20s for one card.
MURMUR_TIMEOUT_MS=90000

# Upper bound on the reply length. One card is ~300 tokens; leave headroom for
# the optional fields.
MURMUR_MAX_TOKENS=900

# How long Ollama keeps the model in VRAM between draws. 10m costs ~6GB of the
# GTX 1080's 8GB but makes the first draw of a session warm.
MURMUR_KEEP_ALIVE=10m

# --- storage ----------------------------------------------------------------
# Kept cards, dismissed titles and the seen list. Gitignored.
MURMUR_DATA_DIR=.data

# --- the overnight deepener -------------------------------------------------
# Not used by the deck. These are read by scripts/deepen-night.sh, the nightly
# job that writes extra curated cards while nobody is looking. Leave them as they
# are unless you move the model file or rebuild llama.cpp.
#
# The model: a 30B MoE distilled from Claude Opus 4.5. It writes far better prose
# than the 8B the deck draws with, at roughly a hundredth of the speed, so it
# never touches the interactive path. scripts/deepen-night.sh starts and stops it.
MURMUR_LLAMACPP_BIN=/home/USER/llama.cpp-moe/build-vk/bin/llama-server
MURMUR_LLAMACPP_GGUF=/home/USER/models/glm-4.7-flash-claude-4.5-opus.iq3_xs.gguf

# Where the deepener's model server listens while it works. Loopback only.
MURMUR_LLAMACPP_URL=http://127.0.0.1:11436
MURMUR_LLAMACPP_PORT=11436

# Context, threads, and cards per night. 4096 is plenty for one card; the job is
# not interactive so it takes its time.
MURMUR_LLAMACPP_CTX=4096
MURMUR_LLAMACPP_THREADS=12
MURMUR_DEEPEN_COUNT=6

# How long one card may take. Measured on this box: 332 tokens at ~1.2 tok/s is
# ~4m40s per card, so keep this several times that. It used to be 5 minutes,
# which killed every single run.
MURMUR_LLAMACPP_TIMEOUT_MS=1800000
