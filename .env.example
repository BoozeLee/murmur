# Copy to .env.local and fill in. Nothing here is required: every value has a
# default that works on this machine.

# --- the model the deepener writes with --------------------------------------
# A 30B mixture-of-experts model distilled from Claude Opus 4.5, running on the
# Vulkan build of llama.cpp as a systemd user service. It is a genuine MoE: 64
# experts, 4 routed per token, ~2.6B active of ~30B.
#
# The deck does not wait for this. It draws from the corpus, which is instant and
# always there, so this model is a batch writer and a second button — not a
# dependency of asking for an idea. One card takes 40-65 seconds here, which is
# why the nightly run is the place it belongs.
MURMUR_LLAMACPP_URL=http://127.0.0.1:11436
MURMUR_LLAMACPP_MODEL=glm-creative

# The weights. The iq2_m quant is the one tuned for this card: ~62% of it lands
# in VRAM and generation runs at ~9 tok/s. The larger iq3_xs and iq4_xs quants
# read better but drop to ~50% GPU residency and ~1 tok/s.
MURMUR_LLAMACPP_GGUF=/home/USER/models/glm-4.7-flash-claude-4.5-opus.iq2_m.gguf

# Which llama-server is NOT a setting here: systemd/murmur-model.service names
# the Vulkan build directly, so `systemd-analyze verify` can still check the path
# exists. There is no CUDA build on this box -- nvcc 12.5 cannot parse the GCC
# headers installed here -- so the Vulkan build is not a preference either.

# How much one card may say. Not the weights' limit but ours: 1200 tokens is
# about two cards' worth of headroom.
MURMUR_LLAMACPP_MAX_TOKENS=1200

# How long one card may take. Measured: 537 tokens at ~8.9 tok/s is ~60s, so a
# card plus its one repair attempt is about two minutes of work, and thirty
# minutes of ceiling is deliberately generous headroom over it. This used to be
# 5 minutes, which killed every single run.
MURMUR_LLAMACPP_TIMEOUT_MS=1800000

# --- how the model server is run --------------------------------------------
# The server holds nearly the whole graphics card, so it is started only by the
# things that actually ask it for a card — the nightly deepener, and an opt-in
# model draw — and shut down again when the deck goes quiet; open-webui is
# stopped while it runs and started again when it stops, because it would
# otherwise take the card back mid-load.
MURMUR_MODEL_UNIT=murmur-model.service
MURMUR_MODEL_IDLE_TIMER=murmur-model-idle.timer
MURMUR_MODEL_BOOT_TIMEOUT_MS=300000
MURMUR_MODEL_POLL_MS=1000

# The 20-minute quiet period itself is NOT an env var: it is `OnActiveSec=20min`
# in murmur-model-idle.timer. Every draw restarts that timer, so the countdown
# always means "twenty minutes since the last card".

# Context, threads and port. 4096 is plenty for one card. These four used to be
# written straight into the server's ExecStart while being offered here as if
# they were knobs -- changing them did nothing. The unit now reads them from the
# environment, and src/lib/docs.test.ts fails if that stops being true.
MURMUR_LLAMACPP_PORT=11436
MURMUR_LLAMACPP_CTX=4096
MURMUR_LLAMACPP_THREADS=12

# --- the overnight deepener -------------------------------------------------
# The same model, run unattended to write extra curated cards into
# .data/corpus/deepened.json. The deck draws from the corpus, so this run is the
# only thing that grows the pool; twelve is about ten minutes of writing a night.
# The pool is capped at 400 cards, and the run checks that before it loads the
# model at all — at the ceiling it prints why and exits in under a second.
MURMUR_DEEPEN_COUNT=12

# --- storage ----------------------------------------------------------------
# Kept cards, dismissed titles, the seen list and the generated half of the
# corpus. Gitignored.
MURMUR_DATA_DIR=.data

# --- the second model, kept but not preferred -------------------------------
# qwen3:8b over Ollama. It is still wired, tested, and still the fastest thing
# on this box (8-15s per card), but nothing prefers it: neither model is on the
# deck's default path any more, and the MoE is the one that writes the corpus at
# night. Reach it by changing POLICIES in src/lib/router.ts, not by editing a
# prompt.
MURMUR_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
MURMUR_TIMEOUT_MS=90000
MURMUR_MAX_TOKENS=900
MURMUR_KEEP_ALIVE=10m
