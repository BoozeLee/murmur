[Unit]
Description=Murmur - painting idea deck (local model, no network calls)
Documentation=file://%h/murmur/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/murmur
Environment=HOME=%h
Environment=NODE_ENV=production
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin
# next start needs a production build; build one only if it is missing.
ExecStartPre=/bin/sh -c 'test -d %h/murmur/.next || bun run build'
ExecStart=bun run start -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target