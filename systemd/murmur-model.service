[Unit]
# Murmur's model server: the 30B MoE the deepener writes the corpus with.
#
# It is NOT started at boot. It holds nearly the whole graphics card, and
# open-webui needs that card too. It is started on demand by whatever asks it for
# a card (see src/lib/model-server.ts) and shut down again by
# murmur-model-idle.timer once she stops painting.
#
# No -ngl on the command line, on purpose: the weights are larger than the card,
# so asking for all of them fails with cudaMalloc out-of-memory. Omitting it lets
# llama.cpp put what fits on the GPU and keep the rest on the CPU.
Description=Murmur model server (GLM 4.7 Flash Claude Opus 4.5 distill, MoE)
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/USER/murmur
Environment=PATH=/home/USER/.bun/bin:/home/USER/.local/bin:/usr/local/bin:/usr/bin

# The defaults live here, BEFORE EnvironmentFile, because EnvironmentFile wins
# whatever comes before it -- so a .env.local can override any of them and
# nothing else can. They have to exist at all: systemd expands a variable that is
# not set to the empty string, so a missing .env.local would otherwise hand
# llama-server "--ctx-size" with no argument and it would refuse to start.
#
# These used to be written straight into ExecStart below while .env.example
# offered the same four as if they were knobs, so editing .env.local did nothing
# at all. src/lib/docs.test.ts now fails if a variable named in .env.example is
# not read by this unit or by the code.
Environment=MURMUR_LLAMACPP_GGUF=/home/USER/models/glm-4.7-flash-claude-4.5-opus.iq2_m.gguf
Environment=MURMUR_LLAMACPP_CTX=4096
Environment=MURMUR_LLAMACPP_THREADS=12
Environment=MURMUR_LLAMACPP_MODEL=glm-creative
Environment=MURMUR_LLAMACPP_PORT=11436
EnvironmentFile=-%h/murmur/.env.local

# The card has to be empty before 10 GB of weights start landing on it. This is
# the measured failure, not a precaution.
ExecStartPre=/home/USER/murmur/scripts/remember-and-release-card.sh

# The executable stays a literal path so systemd-analyze verify can still check
# that it exists -- it cannot resolve a variable when it reads a unit off disk.
# The build it names is a property of this machine, not a tuning knob, which is
# why .env.example no longer lists it.
ExecStart=/home/USER/llama.cpp-moe/build-vk/bin/llama-server \
  --model ${MURMUR_LLAMACPP_GGUF} \
  --alias ${MURMUR_LLAMACPP_MODEL} \
  --host 127.0.0.1 \
  --port ${MURMUR_LLAMACPP_PORT} \
  --ctx-size ${MURMUR_LLAMACPP_CTX} \
  --parallel 1 \
  --threads ${MURMUR_LLAMACPP_THREADS}

# Hand the card back on every exit path, including a crash.
ExecStopPost=/home/USER/murmur/scripts/restore-card.sh

# on-failure rather than always: a model that cannot load should not be retried
# in a tight loop, each attempt re-reading 10 GB off disk.
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
# Deliberately no WantedBy. This unit must never be enabled.